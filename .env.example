# Optional locally: the API otherwise creates data/learning.sqlite3 automatically.
# Export these in the API process; uvicorn does not automatically load this file.
# DATABASE_URL=sqlite:////absolute/existing/directory/learning.sqlite3
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Vite reads this optional development proxy target.
QQ_API_TARGET=http://127.0.0.1:8000

# In Vercel, set DATABASE_URL to your provider's PostgreSQL URI, for example:
# postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# Use COOKIE_SECURE=true for all HTTPS deployments (automatic on Vercel).
